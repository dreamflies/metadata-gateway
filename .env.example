LISTEN_ADDR=:11503
GATEWAY_TOKEN=change-me

# 仅 compose.release.yaml（使用预构建镜像）需要；源码构建时忽略。
# 默认已指向官方发布镜像；自建镜像时改成你自己的 owner。
#GATEWAY_IMAGE=ghcr.io/dreamflies/metadata-gateway
#GATEWAY_TAG=latest

# Javinizer 容器配置。PUID/PGID 建议改为宿主机 `id -u` / `id -g` 的输出。
PUID=1000
PGID=1000
TZ=Asia/Shanghai
JAVINIZER_HOST_PORT=8765
JAVINIZER_SETUP_TRUSTED_CIDRS=172.16.0.0/12

# Compose 内通过服务名访问；直接在宿主机运行网关时改为 http://127.0.0.1:8765。
JAVINIZER_URL=http://javinizer:8765
JAVINIZER_TOKEN=

STASH_BOX_URL=https://stashdb.org/graphql
STASH_BOX_API_KEY=

# Docker 容器通过宿主机 Clash 访问外网时取消以下注释，并按实际 Mixed/HTTP 端口修改。
# Clash 需要开启 Allow LAN；直接在宿主机运行网关时改用 127.0.0.1。
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1,javinizer,host.docker.internal
